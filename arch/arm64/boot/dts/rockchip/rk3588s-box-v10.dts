// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Copyright (c) 2026
 *
 * Vendor-kernel DTS for the board identified from an Android boot.img DTB.
 * Provenance from the extracted DTB:
 *   - model: "Rockchip RK3588S BOX LP4 V10 Board"
 *   - compatible: "rockchip,rk3588s-box-v10", "rockchip,rk3588"
 *
 * The extracted DTB string set matches the RK3588S EVB1 LP4X vendor family
 * more closely than the other in-tree RK3588S vendor boards:
 *   - RK806 single PMIC
 *   - AP6275P Wi-Fi/BT
 *   - FUSB302 Type-C
 *   - HDMI/DP audio nodes
 *
 * Keep the inheritance narrow and disable EVB1 tablet-style peripherals that
 * are not justified by the extracted Android DTB.
 */

/dts-v1/;

#include "rk3588s-tablet-single.dtsi"
#include "rk3588-linux.dtsi"

/ {
	model = "Rockchip RK3588S BOX LP4 V10 Board";
	compatible = "rockchip,rk3588s-box-v10", "rockchip,rk3588";

	/delete-node/ chosen;

	vcc5v0_otg_box: vbus5v0_typec: vcc5v0-otg-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc5v0_otg_en_box>;
	};

	vcc3v3_pcie: vcc3v3-pcie {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		startup-delay-us = <5000>;
		enable-active-high;
		gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc5v0_sys>;
	};

	spdif_tx0_dc: spdif-tx0-dc {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
		status = "okay";
	};

	spdif_tx0_sound: spdif-tx0-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rockchip,spdif";
		simple-audio-card,mclk-fs = <128>;
		status = "okay";

		simple-audio-card,cpu {
			sound-dai = <&spdif_tx0>;
		};

		simple-audio-card,codec {
			sound-dai = <&spdif_tx0_dc>;
		};
	};

	es7148: dummy-codec {
		compatible = "rockchip,dummy-codec";
		#sound-dai-cells = <0>;
		clocks = <&mclkout_i2s1>;
		clock-names = "mclk";
		assigned-clocks = <&mclkout_i2s1>;
		assigned-clock-rates = <12288000>;
		status = "okay";
	};

	vcc_amp_en: vcc-amp-en-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_amp_en";
		enable-active-high;
		gpio = <&gpio0 RK_PD3 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&amp_en_gpio>;
		regulator-always-on;
		regulator-boot-on;
	};

	i2s1_sound: i2s1-sound {
		compatible = "simple-audio-card";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,name = "rockchip,es7148";
		status = "okay";

		simple-audio-card,dai-link@0 {
			format = "i2s";

			cpu {
				sound-dai = <&i2s1_8ch>;
			};

			codec {
				sound-dai = <&es7148>;
			};
		};
	};

};

&{/aliases} {
	/delete-property/ spi5;
};

/delete-node/ &sfc;

&vcc5v0_host {
	gpio = <&gpio0 RK_PD0 GPIO_ACTIVE_HIGH>;
	vin-supply = <&vcc5v0_usb>;
	pinctrl-names = "default";
	pinctrl-0 = <&vcc5v0_host_en>;
};

&pinctrl {
	pinctrl-names = "default";
	pinctrl-0 = <&vcc5v0_limit_en &hdmi_en_gpio>;

	hdmi {
		hdmi_en_gpio: hdmi-en-gpio {
			rockchip,pins = <4 RK_PB5 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};

	audio {
		amp_en_gpio: amp-en-gpio {
			rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		codec_i2s1m0_lrck: codec-i2s1m0-lrck {
			rockchip,pins = <4 RK_PA2 3 &pcfg_pull_none>;
		};

		codec_i2s1m0_sclk: codec-i2s1m0-sclk {
			rockchip,pins = <4 RK_PA1 3 &pcfg_pull_none>;
		};

		codec_i2s1m0_mclk: codec-i2s1m0-mclk {
			rockchip,pins = <4 RK_PA0 3 &pcfg_pull_none>;
		};

		codec_i2s1m0_sdo2: codec-i2s1m0-sdo2 {
			rockchip,pins = <4 RK_PB3 3 &pcfg_pull_none>;
		};
	};

	wireless-bluetooth {
		uart9_gpios_box: uart9-gpios-box {
			rockchip,pins = <3 RK_PD2 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_reset_gpio_box: bt-reset-gpio-box {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_gpio_box: bt-wake-gpio-box {
			rockchip,pins = <0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_irq_gpio_box: bt-irq-gpio-box {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	usb {
		vcc5v0_host_en: vcc5v0-host-en {
			rockchip,pins = <0 RK_PD0 RK_FUNC_GPIO &pcfg_output_high>;
		};

		vcc5v0_limit_en: vcc5v0-limit-en {
			rockchip,pins = <4 RK_PA6 RK_FUNC_GPIO &pcfg_output_high>;
		};
	};
};

/*
 * The vendor DTB exposes HDMI/DP, Type-C, AP6275P and RK806-family strings,
 * but gives no clear evidence for the EVB1's internal panel/touch/sensor
 * stack. Disable those blocks instead of inheriting them by default.
 */
&backlight {
	status = "disabled";
};

&edp0 {
	status = "disabled";
};

&edp0_in_vp2 {
	status = "disabled";
};

&dp0 {
	status = "okay";
};

&dp0_in_vp1 {
	status = "disabled";
};

&dp0_in_vp2 {
	status = "okay";
};

&hall_sensor {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

&i2c5 {
	status = "disabled";
};

&route_edp0 {
	status = "disabled";
};

&hdmi0 {
	enable-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim1_tx0_cec &hdmim0_tx0_hpd
		     &hdmim0_tx0_scl &hdmim0_tx0_sda>;
	status = "okay";
};

&hdmi0_in_vp0 {
	status = "okay";
};

&hdptxphy0 {
	status = "disabled";
};

&hdptxphy_hdmi0 {
	status = "okay";
};

&route_hdmi0 {
	status = "okay";
	logo,mode = "fullscreen";
	connect = <&vp0_out_hdmi0>;
};

&display_subsystem {
	clocks = <&hdptxphy_hdmi0>;
	clock-names = "hdmi0_phy_pll";
};

&hdmi0 {
	cec-enable = "true";
	pinctrl-names = "default";
	pinctrl-0 = <&hdmim1_tx0_cec &hdmim0_tx0_hpd &hdmim0_tx0_scl &hdmim0_tx0_sda>;
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp0 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER0 | 1 << ROCKCHIP_VOP2_ESMART0)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART0>;
};

&vp1 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER1 | 1 << ROCKCHIP_VOP2_ESMART1)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART1>;
};

&vp2 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER2 | 1 << ROCKCHIP_VOP2_ESMART2)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART2>;
};

&vp3 {
	rockchip,plane-mask = <(1 << ROCKCHIP_VOP2_CLUSTER3 | 1 << ROCKCHIP_VOP2_ESMART3)>;
	rockchip,primary-plane = <ROCKCHIP_VOP2_ESMART3>;
};

&{/panel-edp} {
	status = "disabled";
};

&spdif_tx0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spdif0m1_tx>;
	status = "okay";
};

&i2s1_8ch {
	/delete-property/ rockchip,trcm-sync-tx-only;
	/delete-property/ i2s-lrck-gpio;
	pinctrl-names = "default";
	pinctrl-0 = <&codec_i2s1m0_lrck &codec_i2s1m0_sclk
		     &codec_i2s1m0_mclk &codec_i2s1m0_sdo2>;
	rockchip,clk-trcm = <1>;
	rockchip,i2s-tx-route = <2 1 0 3>;
	status = "okay";
};

&uart0 {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

&uart2 {
	status = "disabled";
};

&uart3 {
	status = "disabled";
};

&uart4 {
	status = "disabled";
};

&uart5 {
	status = "disabled";
};

&uart6 {
	status = "disabled";
};

&uart7 {
	status = "disabled";
};

&uart8 {
	status = "disabled";
};

&uart9 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart9m2_xfer &uart9m2_ctsn>;
	status = "okay";
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m2_xfer>;

	vdd_cpu_big0_box: vdd_cpu_big0_mem_box: rk8602@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big0_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_box: vdd_cpu_big1_mem_box: rk8603@43 {
		compatible = "rockchip,rk8603";
		reg = <0x43>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big1_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c2 {
	status = "okay";

	vdd_npu_box: vdd_npu_mem_box: rk8602@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_npu_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <950000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&i2c6 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6m3_xfer>;
	clock-frequency = <400000>;

	/delete-node/ cw2015@62;
	/delete-node/ bq25703@6b;

	tca6507@45 {
		compatible = "ti,tca6507";
		reg = <0x45>;
		gpios = <&gpio4 10 GPIO_ACTIVE_HIGH>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		led@0 {
			reg = <0>;
			label = "front:led0:power";
			linux,default-trigger = "default-on";
		};

		led@1 {
			reg = <1>;
			label = "front:led1:cpu";
			linux,default-trigger = "cpu";
		};

		led@2 {
			reg = <2>;
			label = "front:led2:eth";
			linux,default-trigger = "netdev";
			linux,netdev-name = "end1";
			linux,netdev-link;
			linux,netdev-rx;
			linux,netdev-tx;
		};

		led@3 {
			reg = <3>;
			label = "front:led3:disk";
			linux,default-trigger = "disk-activity";
		};

		led@4 {
			reg = <4>;
			label = "front:led4:usb-gadget";
			linux,default-trigger = "usb-gadget";
		};

		led@5 {
			reg = <5>;
			label = "front:led5:usb-host";
			linux,default-trigger = "usb-host";
		};

		led@6 {
			reg = <6>;
			label = "front:led6:wifi";
			linux,default-trigger = "netdev";
			linux,netdev-name = "wlP4p65s0";
			linux,netdev-link;
			linux,netdev-rx;
			linux,netdev-tx;
		};
	};

	usbc0_box: fusb302@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PC4 IRQ_TYPE_LEVEL_LOW>;
		int-n-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&vcc5v0_otg_box>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				usbc0_role_sw_box: endpoint@0 {
					remote-endpoint = <&dwc3_0_role_switch>;
				};
			};
		};

		usb_con_box: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			sink-pdos = <PDO_FIXED(5000, 100, PDO_FIXED_USB_COMM)>;
			source-pdos = <PDO_FIXED(5000, 300, PDO_FIXED_USB_COMM)>;

			altmodes {
				#address-cells = <1>;
				#size-cells = <0>;

				altmode@0 {
					reg = <0>;
					svid = <0xff01>;
					vdo = <0xffffffff>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_orien_sw_box: endpoint {
						remote-endpoint = <&usbdp_phy0_orientation_switch>;
					};
				};

				port@1 {
					reg = <1>;
					dp_altmode_mux_box: endpoint {
						remote-endpoint = <&usbdp_phy0_dp_altmode_mux>;
					};
				};
			};
		};
	};
};

&cpu_b0 {
	cpu-supply = <&vdd_cpu_big0_box>;
	mem-supply = <&vdd_cpu_big0_mem_box>;
};

&cpu_b1 {
	cpu-supply = <&vdd_cpu_big0_box>;
	mem-supply = <&vdd_cpu_big0_mem_box>;
};

&cpu_b2 {
	cpu-supply = <&vdd_cpu_big1_box>;
	mem-supply = <&vdd_cpu_big1_mem_box>;
};

&cpu_b3 {
	cpu-supply = <&vdd_cpu_big1_box>;
	mem-supply = <&vdd_cpu_big1_mem_box>;
};

&rknpu {
	rknpu-supply = <&vdd_npu_box>;
	mem-supply = <&vdd_npu_mem_box>;
};

&{/charge-animation} {
	regulator-off-in-mem = <&vdd_gpu_s0>, <&vdd_npu_box>,
		<&vdd_vdenc_s0>, <&vdd_gpu_mem_s0>, <&vdd_npu_mem_box>,
		<&vdd_vdenc_mem_s0>, <&vcc_3v3_s0>,
		<&vccio_sd_s0>, <&avdd_0v75_s0>, <&vdd_0v85_s0>,
		<&vdd_cpu_big1_box>, <&vdd_cpu_big0_box>, <&vdd_cpu_lit_s0>,
		<&vdd_cpu_big1_mem_box>, <&vdd_cpu_big0_mem_box>, <&vdd_cpu_lit_mem_s0>,
		<&vddq_ddr_s0>, <&vdd_ddr_s0>, <&vdd_ddr_pll_s0>,
		<&avdd_1v2_s0>, <&vdd_0v75_s0>;
};

&sdio {
	status = "disabled";
};

&sdio_pwrseq {
	status = "disabled";
};

&sdmmc {
	status = "disabled";
};

&sdhci {
	no-led;
};

&vcc_3v3_sd_s0 {
	status = "disabled";
};

&i2c7 {
	status = "disabled";
};

&i2c8 {
	status = "disabled";
	/delete-node/ fusb302@22;
};

&csi2_dcphy0 {
	status = "disabled";
};

&csi2_dcphy1 {
	status = "disabled";
};

&csi2_dphy0_hw {
	status = "disabled";
};

&csi2_dphy1_hw {
	status = "disabled";
};

&mipi_dcphy0 {
	status = "disabled";
};

&mipi_dcphy1 {
	status = "disabled";
};

&mipi0_csi2 {
	status = "disabled";
};

&mipi1_csi2 {
	status = "disabled";
};

&mipi0_csi2_hw {
	status = "disabled";
};

&mipi1_csi2_hw {
	status = "disabled";
};

&mipi2_csi2_hw {
	status = "disabled";
};

&mipi3_csi2_hw {
	status = "disabled";
};

&mipi4_csi2_hw {
	status = "disabled";
};

&mipi5_csi2_hw {
	status = "disabled";
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	rockchip,typec-vbus-det;
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	status = "okay";
	phy-supply = <&vcc5v0_host>;
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	status = "okay";
	phy-supply = <&vcc5v0_host>;
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usbhost3_0 {
	status = "okay";
};

&usbhost_dwc3_0 {
	status = "okay";
	dr_mode = "host";
};

&combphy2_psu {
	status = "okay";
};

&usbdp_phy0 {
	rockchip,dp-lane-mux = <0 1 2 3>;
	orientation-switch;
	svid = <0xff01>;
	sbu1-dc-gpios = <&gpio4 RK_PA3 GPIO_ACTIVE_HIGH>;
	sbu2-dc-gpios = <&gpio4 RK_PA4 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&usbdp_phy0_dp {
	status = "okay";
};

&usbdp_phy0_u3 {
	status = "okay";
};

&usbdp_phy0_orientation_switch {
	remote-endpoint = <&usbc0_orien_sw_box>;
};

&usbdp_phy0_dp_altmode_mux {
	remote-endpoint = <&dp_altmode_mux_box>;
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	dr_mode = "otg";
	status = "okay";
	usb-role-switch;
};

&dwc3_0_role_switch {
	remote-endpoint = <&usbc0_role_sw_box>;
};

&rkcif {
	status = "disabled";
};

&rkcif_mipi_lvds {
	status = "disabled";
};

&rkcif_mipi_lvds_sditf {
	status = "disabled";
};

&rkcif_mipi_lvds1 {
	status = "disabled";
};

&rkcif_mipi_lvds1_sditf {
	status = "disabled";
};

&rkcif_mipi_lvds2 {
	status = "disabled";
};

&rkcif_mipi_lvds2_sditf {
	status = "disabled";
};

&rkcif_mipi_lvds3 {
	status = "disabled";
};

&rkcif_mipi_lvds3_sditf {
	status = "disabled";
};

&fiq_debugger {
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&combphy0_ps {
	status = "okay";
};

&pcie2x1l2 {
	status = "okay";
	reset-gpios = <&gpio3 RK_PD1 GPIO_ACTIVE_HIGH>;
	vpcie3v3-supply = <&vcc3v3_pcie>;
};

&wireless_bluetooth {
	/* Keep rfkill RTS GPIO on the actual UART9 RTSN pin to avoid
	 * fighting uart9m2_ctsn, which is owned by febc0000.serial.
	 */
	uart_rts_gpios = <&gpio3 RK_PD2 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default", "rts_gpio";
	pinctrl-0 = <&uart9m2_rtsn &bt_reset_gpio_box &bt_wake_gpio_box
		     &bt_irq_gpio_box &clk32k_out0>;
	pinctrl-1 = <&uart9_gpios_box>;
	BT,reset_gpio = <&gpio0 RK_PC5 GPIO_ACTIVE_HIGH>;
	BT,wake_gpio = <&gpio0 RK_PC6 GPIO_ACTIVE_HIGH>;
	BT,wake_host_irq = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&uart7 {
	status = "disabled";
};

&wireless_wlan {
	status = "disabled";
};

&es7202_sound_micarray {
	status = "disabled";
};

&es8388_sound {
	status = "disabled";
};

&es8388 {
	status = "disabled";
};

&mpu6500_acc {
	status = "disabled";
};

&mpu6500_gyro {
	status = "disabled";
};

&hym8563 {
	status = "disabled";
};

&aw8601 {
	status = "disabled";
};

&ov50c40 {
	status = "disabled";
};

&otp_eeprom {
	status = "disabled";
};

&vendor_storage {
	status = "disabled";
};

&gmac1 {
	phy-mode = "rgmii";
	clock_in_out = "output";
	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 100000 1500000>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
		     &gmac1_tx_bus2
		     &gmac1_rx_bus2
		     &gmac1_rgmii_clk
		     &gmac1_rgmii_bus>;
	tx_delay = <0x42>;
	rx_delay = <0x37>;
	phy-handle = <&box_rgmii_phy1>;
	status = "okay";
};

&mdio1 {
	box_rgmii_phy1: phy@6 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x6>;
	};
};

&pinctrl {
	usb-box {
		vcc5v0_otg_en_box: vcc5v0-otg-en-box {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
