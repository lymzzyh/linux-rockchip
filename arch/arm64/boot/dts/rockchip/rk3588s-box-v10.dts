};

&mipi1_csi2 {
	status = "disabled";
};

&mipi0_csi2_hw {
	status = "disabled";
};

&mipi1_csi2_hw {
	status = "disabled";
};

&mipi2_csi2_hw {
	status = "disabled";
};

&mipi3_csi2_hw {
	status = "disabled";
};

&mipi4_csi2_hw {
	status = "disabled";
};

&mipi5_csi2_hw {
	status = "disabled";
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	rockchip,typec-vbus-det;
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	status = "okay";
	phy-supply = <&vcc5v0_host>;
};

&u2phy3 {
	status = "okay";
};

&u2phy3_host {
	status = "okay";
	phy-supply = <&vcc5v0_host>;
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};

&usbhost3_0 {
	status = "okay";
};

&usbhost_dwc3_0 {
	status = "okay";
	dr_mode = "host";
};

&combphy2_psu {
	status = "okay";
};

&usbdp_phy0 {
	orientation-switch;
	svid = <0xff01>;
	status = "okay";
};

&usbdp_phy0_dp {
	status = "okay";
};

&usbdp_phy0_u3 {
	status = "okay";
};

&usbdp_phy0_orientation_switch {
	remote-endpoint = <&usbc0_orien_sw_box>;
};

&usbdp_phy0_dp_altmode_mux {
	remote-endpoint = <&dp_altmode_mux_box>;
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	dr_mode = "otg";
	status = "okay";
	usb-role-switch;
};

&dwc3_0_role_switch {
	remote-endpoint = <&usbc0_role_sw_box>;
};

&rkcif {
	status = "disabled";
};

&rkcif_mipi_lvds {
