/*
 * Copyright (c) 2026
 *
 * Vendor-kernel DTS for the board identified from an Android boot.img DTB.
 * Provenance from the extracted DTB:
 *   - model: "Rockchip RK3588S BOX LP4 V10 Board"
 *   - compatible: "rockchip,rk3588s-box-v10", "rockchip,rk3588"
 *
 * The extracted DTB string set matches the RK3588S EVB1 LP4X vendor family
 * more closely than the other in-tree RK3588S vendor boards:
 *   - RK806 single PMIC
 *   - AP6275P Wi-Fi/BT
 *   - FUSB302 Type-C
 *   - HDMI/DP audio nodes
 *
 * Keep the inheritance narrow and disable EVB1 tablet-style peripherals that
 * are not justified by the extracted Android DTB.
 */

/dts-v1/;

#include "rk3588s-tablet-single.dtsi"
#include "rk3588-linux.dtsi"

/ {
	model = "Rockchip RK3588S BOX LP4 V10 Board";
	compatible = "rockchip,rk3588s-box-v10", "rockchip,rk3588";

	/delete-node/ chosen;
};

/*
 * The vendor DTB exposes HDMI/DP, Type-C, AP6275P and RK806-family strings,
 * but gives no clear evidence for the EVB1's internal panel/touch/sensor
 * stack. Disable those blocks instead of inheriting them by default.
 */
&backlight {
	status = "disabled";
};

&edp0 {
	status = "disabled";
};

&edp0_in_vp2 {
	status = "disabled";
};

&hall_sensor {
	status = "disabled";
};

&i2c4 {
	status = "disabled";
};

&i2c5 {
	status = "disabled";
};

&route_edp0 {
	status = "disabled";
};

&{/panel-edp} {
	status = "disabled";
};

&uart0 {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

&uart2 {
	status = "disabled";
};

&uart3 {
	status = "disabled";
};

&uart4 {
	status = "disabled";
};

&uart5 {
	status = "disabled";
};

&uart6 {
	status = "disabled";
};

&uart7 {
	status = "disabled";
};

&uart8 {
	status = "disabled";
};

&uart9 {
	status = "disabled";
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1m2_xfer>;

	vdd_cpu_big0_box: rk8602@42 {
		compatible = "rockchip,rk8602";
		reg = <0x42>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big0_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};

	vdd_cpu_big1_box: rk8603@43 {
		compatible = "rockchip,rk8603";
		reg = <0x43>;
		vin-supply = <&vcc5v0_sys>;
		regulator-compatible = "rk860x-reg";
		regulator-name = "vdd_cpu_big1_s0";
		regulator-min-microvolt = <550000>;
		regulator-max-microvolt = <1050000>;
		regulator-ramp-delay = <2300>;
		rockchip,suspend-voltage-selector = <1>;
		regulator-boot-on;
		regulator-always-on;
		regulator-state-mem {
			regulator-off-in-suspend;
		};
	};
};

&cpu_b0 {
	cpu-supply = <&vdd_cpu_big0_box>;
	mem-supply = <&vdd_cpu_big0_box>;
};

&cpu_b1 {
	cpu-supply = <&vdd_cpu_big0_box>;
	mem-supply = <&vdd_cpu_big0_box>;
};

&cpu_b2 {
	cpu-supply = <&vdd_cpu_big1_box>;
	mem-supply = <&vdd_cpu_big1_box>;
};

&cpu_b3 {
	cpu-supply = <&vdd_cpu_big1_box>;
	mem-supply = <&vdd_cpu_big1_box>;
};

&sdio {
	status = "disabled";
};

&sdio_pwrseq {
	status = "disabled";
};

&i2c7 {
	status = "disabled";
};

&i2c8 {
	status = "disabled";
};

&csi2_dcphy0 {
	status = "disabled";
};

&csi2_dcphy1 {
	status = "disabled";
};

&usbc0 {
	status = "disabled";
};

&rkcif {
	status = "disabled";
};

&rkcif_mipi_lvds {
	status = "disabled";
};

&rkcif_mipi_lvds_sditf {
	status = "disabled";
};

&rkcif_mipi_lvds1 {
	status = "disabled";
};

&rkcif_mipi_lvds1_sditf {
	status = "disabled";
};

&rkcif_mipi_lvds2 {
	status = "disabled";
};

&rkcif_mipi_lvds2_sditf {
	status = "disabled";
};

&rkcif_mipi_lvds3 {
	status = "disabled";
};

&rkcif_mipi_lvds3_sditf {
	status = "disabled";
};

&fiq_debugger {
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&wireless_bluetooth {
	status = "disabled";
};

&uart7 {
	status = "disabled";
};

&wireless_wlan {
	status = "disabled";
};

&es7202_sound_micarray {
	status = "disabled";
};

&es8388_sound {
	status = "disabled";
};

&aw8601 {
	status = "disabled";
};

&ov50c40 {
	status = "disabled";
};

&otp_eeprom {
	status = "disabled";
};

&vendor_storage {
	status = "disabled";
};

&gmac1 {
	phy-mode = "rgmii";
	clock_in_out = "output";
	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 100000 1500000>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_miim
		     &gmac1_tx_bus2
		     &gmac1_rx_bus2
		     &gmac1_rgmii_clk
		     &gmac1_rgmii_bus>;
	tx_delay = <0x42>;
	rx_delay = <0x37>;
	phy-handle = <&box_rgmii_phy1>;
	status = "okay";
};

&mdio1 {
	box_rgmii_phy1: phy@6 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x6>;
	};
};
